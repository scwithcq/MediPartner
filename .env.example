# 数据库连接（application-dev.yml 会读取这些环境变量，未设置时使用默认值）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medipartner
DB_USERNAME=root
DB_PASSWORD=cq

# JWT 签名密钥（生产环境必须替换）
MEDI_JWT_SECRET=MediPartner_Secret_Key_For_Jwt_Only_Dev_2025_ChangeMeInProd

# 消息队列类型：async=进程内异步（默认，无需 RabbitMQ）/ rabbit=真实 MQ（先 docker compose up -d rabbitmq）
MEDI_MQ_TYPE=async

# AI 模型厂商：deepseek（默认，DeepSeek 官方平台）/ qwen / zhipu；不填 Key 时 AI 能力自动降级为本地模板输出（degraded=true）
MEDI_AI_PROVIDER=deepseek
# DeepSeek 官方平台 Key（api.deepseek.com，模型 deepseek-flash）；沿用现有环境变量名 SILICONFLOW_API_KEY，
# 也可用 MEDI_AI_DEEPSEEK_API_KEY 覆盖。该平台无 Embedding 接口，知识库检索自动降级为关键词打分
SILICONFLOW_API_KEY=
MEDI_AI_DEEPSEEK_API_KEY=
MEDI_AI_QWEN_API_KEY=
MEDI_AI_ZHIPU_API_KEY=

# ================= 微信小程序（阶段 6：真实微信能力）=================
# 开关：auto=凭证齐备用真实接口、缺凭证用 mock（默认；配好下面两项即自动切换）；
#       true=强制 mock；false=强制真实（生产建议，缺凭证会明确报错而非悄悄降级）
MEDI_WECHAT_MOCK=auto
# 小程序 AppID 与 AppSecret（微信公众平台 → 开发管理 → 开发设置）
# ⚠ 密钥只从环境变量注入，严禁写进代码或配置文件明文
MEDI_WECHAT_APPID=
MEDI_WECHAT_APPSECRET=
# 微信接口地址（一般无需修改；测试时可指向本地桩服务）
MEDI_WECHAT_BASE_URL=https://api.weixin.qq.com
